        "sync": true,
        "update": {
          "code": "const elements = context.panel.elements;\nconst question = elements.find((e) => e.id === 'question').value;\n\nif (!question) {\n  context.grafana.notifyError(['Error', 'Type a question first.']);\n  return;\n}\n\ncontext.panel.patchFormValue({ answer: 'Thinking...' });\n\nfetch('http://localhost:8082/chat', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ question }),\n})\n  .then(async (resp) => {\n    const body = await resp.json().catch(() => ({}));\n    if (resp.ok) {\n      context.panel.patchFormValue({ answer: body.answer || '(empty answer)' });\n    } else {\n      const msg = body.error || `HTTP ${resp.status}`;\n      context.panel.patchFormValue({ answer: `Error: ${msg}` });\n      context.grafana.notifyError(['Error', msg]);\n    }\n  })\n  .catch((err) => {\n    context.panel.patchFormValue({ answer: `Error: ${err}` });\n    context.grafana.notifyError(['Error', `Failed to reach chat-api: ${err}`]);\n  });\n",
